{
  "name": "bid-app",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "start:client": "npm --prefix client start",
    "start:server": "npm --prefix server run start:dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "test:client": "npm --prefix client test",
    "test:server": "npm --prefix server test",
    "test:e2e": "npm --prefix server run test:e2e",
    "test": "npm run test:client && npm run test:server",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint",
    "lint": "npm run lint:client && npm run lint:server",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jatyon/bid-battle.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Jatyon/bid-battle/issues"
  },
  "homepage": "https://github.com/Jatyon/bid-battle#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^20.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
